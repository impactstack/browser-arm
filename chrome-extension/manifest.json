{
  "manifest_version": 3,
  "name": "Browser Arm",
  "version": "0.1.0",
  "description": "Lets the pi coding agent drive this browser: CDP control over a WebSocket bridge to localhost.",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Browser Arm",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
